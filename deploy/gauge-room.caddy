# >>> gauge-room (managed by go-unmanual-gauge-room deploy; app lives in /opt/gauge-room)
gauge.gounmanual.com {
	encode zstd gzip

	# Excel imports and certificate uploads
	request_body {
		max_size 30MB
	}

	header {
		-Server
		X-Robots-Tag "noindex"
	}

	# No active health check: it would keep the site on 503 for up to one interval after each deploy.
	# Instead, hold requests while the container restarts during a deploy.
	reverse_proxy gauge-app:3000 {
		lb_try_duration 60s
		lb_try_interval 1s
		header_up X-Forwarded-Proto {scheme}
	}
}
# <<< gauge-room

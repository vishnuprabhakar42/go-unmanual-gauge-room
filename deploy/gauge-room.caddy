# >>> gauge-room (managed by go-unmanual-gauge-room deploy; app lives in /opt/gauge-room)
gauge.gounmanual.com {
	encode zstd gzip

	# Excel imports and certificate uploads
	request_body {
		max_size 30MB
	}

	header {
		-Server
		X-Robots-Tag "noindex"
	}

	reverse_proxy gauge-app:3000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
		header_up X-Forwarded-Proto {scheme}
	}
}
# <<< gauge-room

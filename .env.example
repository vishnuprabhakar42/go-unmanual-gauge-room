# ── Core ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gauge_room"
# Used by integration tests (vitest) and Playwright e2e
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gauge_room_test"
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gauge_room_e2e"
APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-please-32chars"
AUTH_TRUST_HOST=true
TZ="Asia/Kolkata"

# ── Email (Mailpit in docker-compose: UI at http://localhost:8025) ──
# Leave SMTP_HOST empty to print emails (incl. magic links) to the server console.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Go Unmanual <no-reply@gounmanual.local>"

# ── WhatsApp ── provider: console | meta
WHATSAPP_PROVIDER="console"
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_API_VERSION="v21.0"

# ── File storage ── local (default, files in ./storage) | s3 (MinIO in docker-compose: console at http://localhost:9001)
STORAGE_DRIVER="local"
STORAGE_DIR="storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="gauge-room"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ── AI (feature-flagged; off by default) ──
AI_CERT_EXTRACTION=false
AI_HEADER_MAPPING=false
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

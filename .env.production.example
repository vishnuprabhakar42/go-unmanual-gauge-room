# ── Go Unmanual · Gauge Room — production settings ──
# Copy to .env.production and fill in. Never commit the real file.

# Database (docker-compose.prod.yml builds DATABASE_URL from these)
POSTGRES_USER=gauge
POSTGRES_PASSWORD=          # long random password
POSTGRES_DB=gauge_room
# Only if you use your own PostgreSQL instead of the compose one:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gauge_room

# Public address of the app (used in emails, QR labels and file links)
APP_URL=https://gauge.example.com
# Same as APP_URL. Required behind a reverse proxy, otherwise sign-in redirects to localhost:3000.
AUTH_URL=https://gauge.example.com
# openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
TZ=Asia/Kolkata

# Email (required for sign-in links, invitations, daily digest)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Go Unmanual <no-reply@your-domain.com>"

# WhatsApp: console (logs only) | meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0

# File storage: local (Docker volume "storage") | s3 (any S3-compatible bucket)
STORAGE_DRIVER=local
STORAGE_DIR=storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional AI features (off by default)
AI_CERT_EXTRACTION=false
AI_HEADER_MAPPING=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
